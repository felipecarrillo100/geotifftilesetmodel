{
  "name": "ria-geotiff",
  "version": "1.0.0",
  "description": "LuciadRIA RasterTileSetModel that streams Cloud Optimized GeoTIFFs (COG): imagery, single and multiband data, and elevation (terrain)",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p demo/tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:no-ria": "node scripts/check-no-ria.mjs",
    "lint": "publint",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:no-ria && npm run lint",
    "prepublishOnly": "npm run verify",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "keywords": [
    "luciadria",
    "luciad",
    "geotiff",
    "cog",
    "cloud-optimized-geotiff",
    "elevation",
    "terrain",
    "raster"
  ],
  "author": "felipecarrillo100",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipecarrillo100/geotifftilesetmodel.git"
  },
  "bugs": {
    "url": "https://github.com/felipecarrillo100/geotifftilesetmodel/issues"
  },
  "homepage": "https://github.com/felipecarrillo100/geotifftilesetmodel#readme",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@luciad/ria": ">=2024.1"
  },
  "dependencies": {
    "geotiff": "~3.0.5"
  },
  "devDependencies": {
    "@luciad/ria": "2026.1.2",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "typescript": "~5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
